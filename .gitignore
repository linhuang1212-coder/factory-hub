# ===== 敏感文件：绝不入库 =====
backend/.env
backend/ADMIN_PASSWORD.txt
backend/.auth_secret
*.env
!*.env.example

# 数据库(含账号哈希与业务数据)
*.db
*.sqlite*

# ===== 环境与缓存 =====
backend/.venv/
backend/venv/
# 仓库根手动建的虚拟环境(IDE 打开仓库根时的默认落点)也要挡，否则一次 git add . 就是上万个文件
/venv/
/.venv/
__pycache__/
*.pyc
.pytest_cache/

# ===== 大二进制：绝不入库 =====
# 以图搜款的 CLIP 视觉模型(服务器上 91MB)，随部署单独放，不进 git
backend/models/
*.onnx
# 客户款图上传目录(服务器上 865 个文件/87MB)
backend/uploads/

# 临时文件(约定 _ 前缀)
# ⚠ 用 _[!_]*.py 而不是 _*.py：__init__.py 也是下划线开头，_*.py 会把它一并忽略，
#   包直接散架。加斜杠锚定只限制"在哪一层目录匹配"，并不会改变文件名通配 ——
#   /_*.py 照样命中根目录的 __init__.py（git check-ignore 实测过）。
backend/_[!_]*.py
backend/_*.db
/_[!_]*.py

# 系统
.DS_Store
Thumbs.db
